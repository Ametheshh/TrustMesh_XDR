{
  "dataset_id": "ciciomt2024_wifi_mqtt",
  "schema_version": "1.0",
  "adapter_version": "1.0",
  "source_root": "data/CICIoMT2024/WiFI_and_MQTT/attacks/csv",
  "filename_pattern": "(?P<label>.+)_(?P<split>train|test)\\.pcap\\.csv",
  "label_fields": ["label_class_original"],
  "columns": ["Header_Length", "Protocol Type", "Duration", "Rate", "Srate", "Drate", "fin_flag_number", "syn_flag_number", "rst_flag_number", "psh_flag_number", "ack_flag_number", "ece_flag_number", "cwr_flag_number", "ack_count", "syn_count", "fin_count", "rst_count", "HTTP", "HTTPS", "DNS", "Telnet", "SMTP", "SSH", "IRC", "TCP", "UDP", "DHCP", "ARP", "ICMP", "IGMP", "IPv", "LLC", "Tot sum", "Min", "Max", "AVG", "Std", "Tot size", "IAT", "Number", "Magnitue", "Radius", "Covariance", "Variance", "Weight"],
  "canonical_mapping": {"Rate": "flow_rate", "IAT": "interarrival_time", "TCP": "protocol_tcp_indicator", "UDP": "protocol_udp_indicator"}
}
