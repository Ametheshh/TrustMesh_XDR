{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trustmesh-canonical-record-v1",
  "title": "TrustMesh canonical record envelope",
  "type": "object",
  "required": ["schema_version", "features", "labels", "provenance", "quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "features": {"type": "object", "description": "Model features only; must exclude all labels, record identifiers and endpoint IPs."},
    "labels": {"type": "object", "properties": {"original": {"type": "object"}, "normalized": {"type": ["string", "null"]}, "binary": {"type": ["integer", "null"], "enum": [0, 1, null]}, "label_source": {"type": ["string", "null"]}}},
    "provenance": {"type": "object", "required": ["record_id", "dataset_id", "source_file", "adapter_version", "schema_version"], "properties": {"record_id": {"type": "string", "description": "Internal provenance identifier; forbidden in ML input."}, "dataset_id": {"type": "string"}, "source_file": {"type": "string"}, "source_split": {"type": ["string", "null"]}, "source_row": {"type": ["integer", "null"]}, "adapter_version": {"type": "string"}, "schema_version": {"type": "string"}, "client_id": {"type": ["string", "null"]}}},
    "quality": {"type": "object", "properties": {"flags": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}},
    "restricted": {"type": "object", "description": "Staging-only fields; excluded from canonical shared feature view."}
  },
  "additionalProperties": false
}
